  "tokenColors": [
    {
      "name": "Comentarios - gris tenue (jerarquía baja)",
      "scope": [
        "comment",
        "comment.block",
        "comment.line"
      ],
      "settings": {
        "foreground": "#6a6a6a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comentarios de documentación - lima atenuado",
      "scope": [
        "comment.block.documentation",
        "comment.entity"
      ],
      "settings": {
        "foreground": "#4d5a3a",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Palabras clave / estructura - LIMA (color principal)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control de flujo (if, return, for...)",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.break",
        "keyword.control.continue"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declaraciones (const, let, var, function, class)",
      "scope": [
        "storage.type.function",
        "storage.type.class",
        "storage.type.var",
        "storage.type.js",
        "storage.type.ts"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "bold"
      }
    },

    {
      "name": "Operadores - gris lima",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#b4d88a"
      }
    },

    {
      "name": "Funciones - aguamarina (acción/call)",
      "scope": [
        "entity.name.function",
        "entity.name.function.declaration",
        "support.function",
        "entity.name.method",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Nombres de métodos - aguamarina",
      "scope": [
        "entity.name.function",
        "support.function.construct"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },

    {
      "name": "Clases / Tipos - Lima brillante (tipos nuevos)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#b4f70f",
        "fontStyle": "bold"
      }
    },

    {
      "name": "Constantes / macros / this / super - MORADO",
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.language",
        "keyword.this",
        "variable.language.this",
        "variable.language.super",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "name": "Valores booleanos y null - morado",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#ae81ff",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Cadenas / strings - AGUAMARINA",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Interpolación de plantillas - lima",
      "scope": [
        "string.template.embedded",
        "variable.template",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },

    {
      "name": "Números - Lima pastel",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#c9f27a"
      }
    },

    {
      "name": "Variables - Gris lima claro",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d6e6d6"
      }
    },
    {
      "name": "Variables declaradas - lima suave",
      "scope": [
        "variable.declaration",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#cfeeb0"
      }
    },

    {
      "name": "Propiedades / atributos - gris verdoso",
      "scope": [
        "variable.other.member",
        "support.variable.property",
        "variable.other.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b8c8a8"
      }
    },
    {
      "name": "Atributos HTML/CSS - lima tenue",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.css"
      ],
      "settings": {
        "foreground": "#9fd04f"
      }
    },

    {
      "name": "Tags HTML - LIMA fuerte",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Puntuación de tags - gris",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.string",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#8a9a8a"
      }
    },

    {
      "name": "Selectores CSS - aguamarina",
      "scope": [
        "meta.selector.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.class.css",
        "support.type.property.css"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "name": "Propiedades CSS - gris verdoso",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#b8c8a8"
      }
    },

    {
      "name": "Imports / módulos - morado suave",
      "scope": [
        "variable.other.constant",
        "entity.name.import",
        "support.module"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "name": "Keywords de import - lima",
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.module"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },

    {
      "name": "Decoradores / anotaciones - morado",
      "scope": [
        "meta.decorator",
        "annotation",
        "keyword.declaration.annotation",
        "decorator"
      ],
      "settings": {
        "foreground": "#ae81ff",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Tipos de primitivos - morado (boolean, int...)",
      "scope": [
        "storage.type.primitive",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },

    {
      "name": "Paréntesis / llaves - gris lima",
      "scope": [
        "punctuation.definition.block",
        "punctuation.section.block",
        "punctuation.section.group",
        "meta.brace",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#9fbf84"
      }
    },

    {
      "name": "Identificadores de variables globales / CLI - lima",
      "scope": [
        "variable.global",
        "constant.character.escape",
        "constant.other.key"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },

    {
      "name": "Texto inválido / deprecado - gris tachado",
      "scope": [
        "invalid.deprecated",
        "meta.diff.header",
        "comment.diff"
      ],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "strikethrough"
      }
    },

    {
      "name": "Print / console - aguamarina",
      "scope": [
        "support.class.console",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#a6e22e",
    "function": "#66d9ef",
    "class": "#b4f70f",
    "type": "#b4f70f",
    "variable": "#d6e6d6",
    "property": "#b8c8a8",
    "string": "#66d9ef",
    "number": "#c9f27a",
    "comment": "#6a6a6a",
    "constant": "#ae81ff",
    "parameter": "#d6e6d6",
    "namespace": "#a6e22e",
    "interface": "#b4f70f",
    "enum": "#b4f70f",
    "enumMember": "#ae81ff",
    "method": "#66d9ef",
    "macro": "#ae81ff",
    "struct": "#b4f70f",
    "union": "#b4f70f",
    "generator": "#a6e22e",
    "operator": "#b4d88a",
    "importDeclaration": "#ae81ff"
  }
}
